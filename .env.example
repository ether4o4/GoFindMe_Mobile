# GoFindMe configuration. Copy to .env and adjust, or export these in your shell.
# Nothing here is secret by default; the vault passphrase and login password are
# set at runtime, never stored in this file.

# --- Network ---
# Bind address. Default is loopback only. Set to 0.0.0.0 ONLY behind a private
# tunnel (Tailscale/WireGuard) or a TLS reverse proxy with auth in front.
GOFINDME_BIND=127.0.0.1
GOFINDME_PORT=8000

# --- Storage ---
# SQLite database path and uploads dir (created on first run).
GOFINDME_DB=./data/gofindme.db
GOFINDME_UPLOADS_DIR=./data/uploads

# --- Vault ---
# encrypted (default) | plaintext. Plaintext stores API keys unencrypted on disk.
GOFINDME_VAULT_MODE=encrypted
# Minutes of inactivity before the unlocked vault auto-locks.
GOFINDME_VAULT_IDLE_MINUTES=30

# --- Auth ---
# Days a login token stays valid.
GOFINDME_TOKEN_TTL_DAYS=7

# --- Jobs ---
# Max tools/providers executing at once.
GOFINDME_MAX_CONCURRENCY=4

# --- Tool management ---
# Allow install/update of OSINT tools from the dashboard (runs package managers).
# High impact: only the authenticated owner can trigger it. Set to 0 to disable.
GOFINDME_ALLOW_TOOL_MGMT=1

# --- Outbound HTTP ---
# Optional CA bundle override for provider calls. httpx also honors HTTPS_PROXY
# and SSL_CERT_FILE from the environment automatically.
# GOFINDME_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
